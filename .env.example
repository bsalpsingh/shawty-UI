# shawty-ui environment variables
# Copy to `.env.local` and fill in real values.

# --- Supabase (auth only; GitHub provider) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXX

# --- Shawty API ---
# Same-origin path proxied by the Vite dev server (recommended for local dev).
VITE_API_BASE_URL=/api
# Where the dev server proxies /api to (kubectl port-forward target).
VITE_DEV_API_TARGET=http://localhost:8010

# Or call a deployed API directly (requires CORS on the backend):
# VITE_API_BASE_URL=https://api.shawty.example.com
