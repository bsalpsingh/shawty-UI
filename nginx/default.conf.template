server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # The ui is a single page on "/" — everything else is a short code and
    # belongs to the api, which owns the "/{short_code}" redirect route.

    location = / {
        try_files /index.html =404;
    }

    # API reverse proxy.
    # The UI bundle calls `${API_BASE_URL}/short-url` (i.e. `/api/short-url`).
    # We strip the `/api` prefix and forward to the shawty backend service.
    location /api/ {
        proxy_pass http://shawty-svc.shawty.svc.cluster.local:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Runtime configuration — generated from the k8s Secret by
    # docker-entrypoint.d/20-generate-env-config.sh. Never cache it.
    location = /env-config.js {
        add_header Cache-Control "no-store" always;
        add_header Pragma "no-cache" always;
    }

    # Vite hashes assets under /assets, serve them long-lived.
    location /assets/ {
        access_log off;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    # Root-level static files (favicon, fonts, ...).
    location ~* \.(?:ico|png|svg|jpe?g|webp|woff2?|ttf|map)$ {
        try_files $uri =404;
    }

    # Anything else is a short code — hand it to the api so it can redirect.
    location / {
        proxy_pass http://shawty-svc.shawty.svc.cluster.local:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
